# ===== ローカル開発（SQLite） =====
DATABASE_URL="file:./dev.db"

# ===== 本番（PostgreSQL / Supabase等）の例 =====
# DATABASE_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres"

# セッション署名キー。本番では必ず長いランダム文字列に変更すること
# 生成例: openssl rand -base64 32
SESSION_SECRET="change-me-in-production"

# ===== ローカル検証（本番では設定しない） =====
# DEMO_MODE="1"   # ログイン画面にワンクリックログイン・仮想時計バーを表示
