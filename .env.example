# ===== ローカル開発（SQLite） =====
DATABASE_URL="file:./dev.db"

# ===== 本番（PostgreSQL / Supabase等）の例 =====
# DATABASE_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres"

# セッション署名キー。本番では必ず長いランダム文字列に変更すること
# 生成例: openssl rand -base64 32
SESSION_SECRET="change-me-in-production"

# ===== メール送信（顧客セルフ登録のメール認証） =====
# Resend（https://resend.com）のAPIキー。未設定時は送信せずサーバーログに確認URLを出力（開発モード）
# RESEND_API_KEY="re_xxxxxxxx"
# 差出人（Resendで認証済みのドメイン）
# MAIL_FROM="CEREMOS <no-reply@your-domain.jp>"
# メール内リンクのベースURL（本番で必須。例: https://ceremos.your-domain.jp）
# APP_URL="http://localhost:3000"

# ===== Googleログイン（任意） =====
# 設定手順:
#   1. https://console.cloud.google.com/apis/credentials で「OAuthクライアントID（ウェブアプリ）」を作成（無料）
#   2. 承認済みリダイレクトURIに「 http://localhost:3000/api/v1/auth/google/callback 」
#      （本番は https://本番ドメイン/api/v1/auth/google/callback ）を追加
#   3. 発行されたIDとシークレットを以下に設定 → ログイン画面に「Googleでログイン」が表示されます
# ※ メールアドレスが一致する既存ユーザーのみログイン可（Googleからの自動アカウント作成はしません）
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"
